#!/usr/bin/env node
/**
 * commonplace — CLI dispatcher for all plugin scripts.
 * Added to PATH by Claude Code while the plugin is active.
 * Also invocable directly: node /path/to/bin/commonplace <cmd> [args]
 *
 * Usage: commonplace <command> [args...]
 */

import { spawnSync } from 'child_process';
import { fileURLToPath } from 'url';
import { join, dirname } from 'path';
import { readdirSync, existsSync } from 'fs';

const __dirname = dirname(fileURLToPath(import.meta.url));

const SCRIPTS = {
  // Core vault scripts
  'index':        'scripts/index.ts',
  'lint':         'scripts/lint.ts',
  'validate':     'scripts/validate.ts',
  'scope-check':  'scripts/scope-check.ts',
  'score':        'scripts/vault-score.ts',
  'prune':        'scripts/prune.ts',
  'init':         'scripts/init.ts',
  'discover-genres': 'scripts/discover-genres.ts',
  'link':         'scripts/link.ts',
  'post-write':   'scripts/post-write.ts',
  'raw':          'scripts/raw.ts',
  'freshen':      'scripts/freshen.ts',
  'log':          'scripts/log.ts',
  'impact':       'scripts/impact.ts',
  'cross-domain': 'scripts/cross-domain.ts',
  'deep-link':    'scripts/deep-link.ts',
  'hub-score':    'scripts/hub-score.ts',
  'connect':      'scripts/connect.ts',
  'post-write-research': 'scripts/post-write-research.ts',
  'prompt-context':      'scripts/prompt-context.ts',
  'agent-guard':         'scripts/agent-guard.ts',
  'cleanup-cache':       'scripts/cleanup-cache.ts',
  'moc:sync':            'scripts/moc-sync.ts',
  'supersede':           'scripts/supersede.ts',
  'vaults':              'scripts/vaults.ts',
  'vault':               'scripts/vault.ts',
  'eval:retrieval':      'evals/retrieval/run.ts',
  'eval:connect':        'evals/connect/run.ts',
  'eval:connection':     'evals/connection/run.ts',
  'eval:judge':          'evals/judge/run.ts',
  'abstract':            'scripts/abstract.ts',
  'seed':                'scripts/seed.ts',
  // Paper pipeline
  'paper:fetch':          'scripts/paper/fetch-paper.ts',
  'paper:extract':        'scripts/paper/extract-sections.ts',
  'paper:smart-extract':  'scripts/paper/smart-extract.ts',
  'paper:detect':         'scripts/paper/detect-sections.ts',
  'paper:enrich':         'scripts/paper/enrich-metadata.ts',
  'paper:citations':      'scripts/paper/analyze-citations.ts',
  'paper:figures':        'scripts/paper/extract-figures.ts',
  'paper:quality':        'scripts/paper/quality-check.ts',
  'paper:compare':        'scripts/paper/compare-papers.ts',
  'paper:groundedness-check': 'scripts/paper/groundedness-check.ts',
};

const [,, cmd, ...args] = process.argv;

// Built-ins: instant lookups without spawning tsx.
//
// The precedence MUST match chooseVault() in scripts/lib/vault.ts:
//   --vault <id|alias|path> → project pin → cwd walk-up → registry default
//   (a private vault is never the default). scripts/lib/vault-path-parity.test.ts
//   runs both against the same fixtures; it used to be the reverse order, so a
//   session inside vault B printed the default A while every script used B.
if (cmd === 'vault-path' || cmd === 'config') {
  const { readFileSync } = await import('fs');
  const { resolve } = await import('path');
  const dataDir = process.env.CLAUDE_PLUGIN_DATA;
  const homeDir = process.env.HOME || process.env.USERPROFILE || '';
  const dataLocs = (name) => {
    const locs = [
      ...(dataDir ? [join(dataDir, name)] : []),
      join(__dirname, '..', name),
    ];
    if (homeDir) {
      try {
        const root = join(homeDir, '.claude', 'plugins', 'data');
        for (const dir of readdirSync(root)) {
          if (dir.startsWith('commonplace-')) locs.push(join(root, dir, name));
        }
      } catch {}
    }
    return locs;
  };
  const readJson = (name) => {
    for (const loc of dataLocs(name)) {
      try { return JSON.parse(readFileSync(loc, 'utf-8')); } catch {}
    }
    return null;
  };
  let reg = null;
  for (const loc of dataLocs('vaults.json')) {
    try {
      const r = JSON.parse(readFileSync(loc, 'utf-8'));
      if (Array.isArray(r.vaults) && r.vaults.length > 0) { reg = r; break; }
    } catch {}
  }
  const vaults = (reg?.vaults || []).filter((v) => v && typeof v.id === 'string' && typeof v.path === 'string');
  const strip = (p) => String(p).replace(/[\\/]+$/, '');
  const byRef = (ref) => {
    const r = String(ref).trim().toLowerCase();
    return vaults.find((v) => v.id.toLowerCase() === r)
      || vaults.find((v) => (v.aliases || []).some((a) => String(a).toLowerCase() === r))
      || vaults.find((v) => String(v.label || v.id).toLowerCase() === r)
      || vaults.find((v) => strip(v.path) === strip(String(ref).trim()));
  };
  const callerCwd = resolve(process.env.COMMONPLACE_CALLER_CWD || process.cwd());

  let vp;
  // 1. --vault
  const vi = args.indexOf('--vault');
  if (vi !== -1 && args[vi + 1]) {
    const hit = byRef(args[vi + 1]);
    vp = hit ? hit.path : resolve(args[vi + 1]);
  }
  // 2. project pin (longest pinned root containing cwd)
  if (!vp) {
    const pins = readJson('vault-pins.json') || {};
    let best;
    for (const root of Object.keys(pins)) {
      const r = strip(root);
      if ((callerCwd === r || callerCwd.startsWith(r + '/')) && (!best || r.length > best.length)) best = r;
    }
    const hit = best !== undefined ? byRef(pins[best] ?? pins[best + '/']) : undefined;
    if (hit) vp = hit.path;
  }
  // 3. cwd walk-up
  if (!vp) {
    let current = callerCwd;
    while (current !== '/') {
      if (existsSync(join(current, '.obsidian')) || existsSync(join(current, '.wiki'))) {
        vp = current;
        break;
      }
      current = resolve(current, '..');
    }
  }
  // 4. registry default (never private), then the legacy .vault-path mirror
  if (!vp) {
    const def = vaults.find((v) => v.id === reg?.default && v.isPrivate !== true);
    if (def) vp = def.path;
  }
  if (!vp && !reg) for (const loc of dataLocs('.vault-path')) {
    try { vp = readFileSync(loc, 'utf-8').trim(); if (vp) break; } catch {}
  }
  if (!vp) {
    console.error('commonplace: no vault resolves here — run commonplace init');
    process.exit(1);
  }
  if (cmd === 'vault-path') {
    console.log(vp);
  } else {
    // config: print .wiki/config.json
    try {
      console.log(readFileSync(join(vp, '.wiki', 'config.json'), 'utf-8'));
    } catch {
      console.error('commonplace: no .wiki/config.json found — run commonplace init');
      process.exit(1);
    }
  }
  process.exit(0);
}

if (!cmd || cmd === '--help' || cmd === '-h') {
  console.error('Usage: commonplace <command> [args...]');
  console.error('');
  console.error('Commands:');
  console.error('  vault-path    Print configured vault path');
  console.error('  config        Print .wiki/config.json');
  console.error('  index         Build/update .wiki/*.json indexes');
  console.error('  lint          Vault health audit');
  console.error('  validate      Single-file frontmatter validation');
  console.error('  scope-check   Domain scope enforcement');
  console.error('  score         Compute vault quality score');
  console.error('  prune         Remove low-value concept stubs');
  console.error('  init          Initialize plugin for a vault');
  console.error('  discover-genres  Re-run genre discovery; refresh .wiki/conventions.json');
  console.error('  link          Insert wikilinks for known concepts/sources/MOCs (deterministic)');
  console.error('  post-write    Post-write hook pipeline (reads stdin)');
  console.error('  raw           Scan raw/ folder for uningested files');
  console.error('  freshen       Sample live source URLs for freshness checking');
  console.error('  log           Append an entry to .wiki/log.md');
  console.error('  impact        Find existing notes affected by a source');
  console.error('  cross-domain  Find cross-domain bridge concepts for a source');
  console.error('  deep-link     Find implicit concept connections via embeddings (requires Ollama)');
  console.error('  connect       Ranked pool of notes graph-close to a query/note (PPR substrate for wiki-query)');
  console.error('  moc:sync      Reconcile MOC headers/bullet lists with the source index');
  console.error('  supersede     Retire an entity superseded by a successor; propagate live-framing rewrites');
  console.error('  vaults        List registered vaults or match one by name');
  console.error('  vault         Show/choose the active vault: show | list | use <id> [--default] | unpin');
  console.error('');
  console.error('  paper:fetch          Download paper from arXiv/URL');
  console.error('  paper:extract        Extract pages from PDF');
  console.error('  paper:smart-extract  Adaptive full PDF extraction');
  console.error('  paper:detect         Detect section headers');
  console.error('  paper:enrich         Fetch external metadata');
  console.error('  paper:citations      Analyze citation network');
  console.error('  paper:figures        Extract figure/table captions');
  console.error('  paper:quality        Score analysis quality');
  console.error('  paper:compare        Compare two papers');
  process.exit(0);
}

if (!SCRIPTS[cmd]) {
  console.error(`commonplace: unknown command '${cmd}'`);
  console.error(`Run 'commonplace --help' for available commands.`);
  process.exit(1);
}

const root = join(__dirname, '..');
const tsx = join(root, 'node_modules', '.bin', 'tsx');
const scriptPath = join(root, SCRIPTS[cmd]);

const result = spawnSync(tsx, [scriptPath, ...args], {
  stdio: 'inherit',
  cwd: root,
  env: { ...process.env, COMMONPLACE_CALLER_CWD: process.cwd() },
});

process.exit(result.status ?? 1);
