{
  "name": "commonplace",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "bin": {
    "commonplace": "./bin/commonplace"
  },
  "description": "LLM-maintained knowledge base for Obsidian vaults",
  "scripts": {
    "test": "npm run typecheck && node --import tsx --test \"scripts/**/*.test.ts\" \"evals/**/*.test.ts\" \"hooks/**/*.test.ts\"",
    "index": "tsx scripts/index.ts",
    "lint": "tsx scripts/lint.ts",
    "validate": "tsx scripts/validate.ts",
    "scope-check": "tsx scripts/scope-check.ts",
    "vault-score": "tsx scripts/vault-score.ts",
    "prune": "tsx scripts/prune.ts",
    "eval:retrieval": "tsx evals/retrieval/run.ts",
    "eval:connection": "tsx evals/connection/run.ts",
    "eval:judge": "tsx evals/judge/run.ts",
    "eval:connect": "tsx evals/connect/run.ts",
    "eval:scale": "tsx evals/scale/run.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.hooks.json",
    "test:ui": "tsx scripts/test-ui.ts",
    "build": "tsx scripts/build.ts"
  },
  "dependencies": {
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "pdfjs-dist": "^4.9.155",
    "tsx": "^4.19.0",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
