{
  "name": "commonplace",
  "version": "2.5.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "commonplace": "./bin/commonplace"
  },
  "description": "LLM-maintained knowledge base for Obsidian vaults",
  "scripts": {
    "test": "npm run typecheck && node --test \"scripts/**/*.test.ts\" \"evals/**/*.test.ts\" \"hooks/**/*.test.ts\"",
    "index": "node scripts/index.ts",
    "lint": "node scripts/lint.ts",
    "validate": "node scripts/validate.ts",
    "scope-check": "node scripts/scope-check.ts",
    "vault-score": "node scripts/vault-score.ts",
    "prune": "node scripts/prune.ts",
    "eval:retrieval": "node evals/retrieval/run.ts",
    "eval:connection": "node evals/connection/run.ts",
    "eval:judge": "node evals/judge/run.ts",
    "eval:connect": "node evals/connect/run.ts",
    "eval:scale": "node evals/scale/run.ts",
    "explain:render": "node scripts/explain-render.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.hooks.json",
    "test:ui": "node scripts/test-ui.ts"
  },
  "dependencies": {
    "pdfjs-dist": "^4.9.155"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "gray-matter": "^4.0.3",
    "typescript": "^5.9.3"
  }
}
